<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>

        <Socket name="LogstashSocket" host="logstash-stickers" port="5045" protocol="TCP">
            <JsonLayout compact="true" eventEol="true" properties="true">
                <KeyValuePair key="service.name" value="geolocalization"/>
            </JsonLayout>
            <ReconnectionDelay>5000</ReconnectionDelay>
        </Socket>
    </Appenders>

    <Loggers>
        <Logger name="com.edu.infnet.pb.geolocalization" level="info" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="LogstashSocket"/>
        </Logger>

        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>